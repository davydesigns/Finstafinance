{
  "expo": {
    "name": "Finsta",
    "slug": "fintech-ds",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2557BD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Finsta: Fintech Design System",
      "shortName": "Finsta",
      "description": "Finsta: a production-quality React Native fintech design system with tokens, light and dark themes, accessible components and AI patterns. Designed by Davy Designs.",
      "themeColor": "#2557BD",
      "backgroundColor": "#F6F8FB"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset"
    ],
    "scheme": "fintechds",
    "experiments": {
      "typedRoutes": true
    }
  }
}
