{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Expo",
      "type": "shell",
      "command": "source ~/.nvm/nvm.sh && nvm use && npm start",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" },
      "runOptions": { "runOn": "folderOpen" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Check (types, lint, tests)",
      "type": "shell",
      "command": "source ~/.nvm/nvm.sh && nvm use && npm run check",
      "problemMatcher": []
    }
  ]
}
